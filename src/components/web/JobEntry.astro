---
import type { Job } from '../../data';
import StackList from './StackList.astro';

interface Props {
	job: Job;
	presentLabel: string;
}

const { job, presentLabel } = Astro.props;

const end = job.current ? presentLabel : job.end;
// En dash, per the owner's copy rule. A role with no end date shows its start year alone.
const range = end && end !== job.start ? `${job.start} – ${end}` : job.start;
---

<article class="job">
	<div class="job__head">
		<h3 class="job__title">
			<span class="job__role">{job.role}</span>
			<span class="job__company">{job.company}</span>
		</h3>
		<span class="job__leader" aria-hidden="true"></span>
		<p class="job__when">
			<span class="job__range">{range}</span>
			{job.location && <span class="job__loc">{job.location}</span>}
		</p>
	</div>

	{job.summary && <p class="job__summary">{job.summary}</p>}

	{
		job.highlights.length > 0 && (
			<ul class="job__highlights">
				{job.highlights.map((highlight) => (
					<li>{highlight}</li>
				))}
			</ul>
		)
	}

	<StackList items={job.stack} />
</article>

<style>
	.job {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: var(--content-col);
		break-inside: avoid;
	}

	.job__head {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.25rem;
	}

	.job__role {
		display: block;
		font-family: var(--font-serif);
		font-size: var(--step-role);
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.012em;
		color: var(--ink);
		text-wrap: balance;
	}

	.job__company {
		display: block;
		margin-top: 0.125rem;
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--ink-2);
	}

	.job__leader {
		display: none;
	}

	.job__when {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		font-family: var(--font-sans);
		font-size: var(--step-meta);
		line-height: 1.4;
		white-space: nowrap;
	}

	.job__range {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.02em;
		color: var(--ink-2);
	}

	.job__loc {
		color: var(--ink-3);
	}

	.job__summary {
		font-family: var(--font-serif);
		font-size: 1.0625rem;
		font-style: italic;
		line-height: 1.55;
		color: var(--ink-2);
		max-width: var(--measure);
	}

	.job__highlights {
		display: flex;
		flex-direction: column;
		gap: 0.4375rem;
		max-width: var(--measure);
	}

	.job__highlights li {
		position: relative;
		padding-left: 1.125rem;
		line-height: 1.6;
		color: var(--ink-2);
		text-wrap: pretty;
	}

	.job__highlights li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.72em;
		width: 0.5rem;
		height: 1px;
		background: var(--rule-strong);
	}

	@media (min-width: 40rem) {
		.job__head {
			flex-direction: row;
			align-items: baseline;
			gap: 0.75rem 0.75rem;
		}

		/* A dotted leader, the classic print-resume device, ties the role to its
		   date instead of leaving them stranded at opposite ends of the row. */
		.job__leader {
			display: block;
			flex: 1 1 auto;
			min-width: 1.5rem;
			align-self: flex-end;
			margin-bottom: 0.4em;
			border-bottom: 1px dotted var(--rule-strong);
		}

		.job__when {
			flex: none;
			justify-content: flex-end;
			text-align: right;
		}
	}
</style>
