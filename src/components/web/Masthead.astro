---
import { withBase, type Resume } from '../../data';
import ContactList from './ContactList.astro';
import DownloadPdf from './DownloadPdf.astro';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props {
	resume: Resume;
}

const { resume } = Astro.props;

const NBSP = ' ';

// Bind a middot separator to the words before it, and the final two words to
// each other, so neither a separator nor a lone last word opens a new line.
const preventWidows = (text: string) => {
	const bound = text.split(' · ').join(`${NBSP}· `);
	const words = bound.split(' ');
	if (words.length < 2) return bound;
	return `${words.slice(0, -2).join(' ')} ${words.slice(-2).join(NBSP)}`.trim();
};
---

<header class="masthead">
	<div class="masthead__bar no-print">
		<LanguageSwitch locale={resume.locale} label={resume.ui.languageSwitch} />
		<DownloadPdf locale={resume.locale} label={resume.ui.downloadPdf} />
	</div>

	<div class="masthead__main">
		<div class="masthead__identity">
			<h1 class="masthead__name">{resume.name}</h1>
			<p class="masthead__headline">{preventWidows(resume.headline)}</p>
			<p class="masthead__tagline">{preventWidows(resume.tagline)}</p>
		</div>

		<figure class="masthead__figure">
			<img
				class="masthead__photo"
				src={withBase('/photo.jpg')}
				alt={resume.ui.photoAlt}
				width="940"
				height="788"
				decoding="async"
				fetchpriority="high"
			/>
		</figure>

		<div class="masthead__meta">
			<p class="facts">
				<span class="facts__place">{resume.location}</span>
				<span class="facts__sep" aria-hidden="true">·</span>
				<span class="facts__avail"><span class="facts__dot" aria-hidden="true"></span>{resume.availability}</span>
			</p>

			{
				resume.languages.length > 0 && (
					<ul class="langs" aria-label={resume.ui.languages}>
						{resume.languages.map((language) => (
							<li class="langs__item">
								<span class="langs__name">{language.name}</span>
								<span class="langs__level">{language.level}</span>
							</li>
						))}
					</ul>
				)
			}

			<ContactList contact={resume.contact} label={resume.ui.contact} />
		</div>
	</div>

	<div class="masthead__rule" aria-hidden="true"></div>
</header>

<style>
	.masthead {
		padding-block: 1rem clamp(1.75rem, 3vw, 2.5rem);
	}

	.masthead__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-left: -0.5rem;
		margin-bottom: clamp(1.75rem, 4vw, 3rem);
	}

	/* Mobile order is DOM order: name, headline, tagline, portrait, then the facts.
	   The name leads; the portrait still sits near the top. */
	.masthead__main {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.masthead__figure {
		width: max-content;
		align-self: start;
		overflow: hidden;
		background: var(--photo-surface);
		isolation: isolate;
	}

	.masthead__photo {
		width: 112px;
		height: 136px;
		object-fit: cover;
		object-position: 50% 14%;
		filter: var(--photo-filter);
		mix-blend-mode: var(--photo-blend);
		-webkit-mask-image: var(--photo-mask);
		mask-image: var(--photo-mask);
		/* Zoom past the vector motif at the source's left and right edges. */
		transform: scale(1.28);
		transform-origin: 50% 24%;
	}

	.masthead__name {
		font-family: var(--font-serif);
		font-size: var(--step-name);
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -0.025em;
		text-wrap: balance;
		color: var(--ink);
	}

	.masthead__headline {
		margin-top: 0.625rem;
		font-family: var(--font-sans);
		font-size: var(--step-headline);
		font-weight: 500;
		line-height: 1.35;
		letter-spacing: -0.005em;
		color: var(--ink);
		text-wrap: balance;
	}

	.masthead__tagline {
		margin-top: 0.375rem;
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--ink-3);
		max-width: 40ch;
		text-wrap: balance;
	}

	.facts {
		font-family: var(--font-sans);
		font-size: var(--step-meta);
		line-height: 1.55;
		color: var(--ink-2);
		max-width: 56ch;
	}

	.facts__place {
		font-weight: 600;
		color: var(--ink);
	}

	.facts__sep {
		color: var(--rule-strong);
		padding-inline: 0.375rem;
	}

	.facts__dot {
		display: inline-block;
		width: 0.4375rem;
		height: 0.4375rem;
		margin-right: 0.4375rem;
		margin-bottom: 0.0625rem;
		border-radius: 50%;
		background: var(--accent);
		vertical-align: middle;
	}

	.langs {
		display: flex;
		flex-wrap: wrap;
		margin-top: 0.4375rem;
		font-family: var(--font-sans);
		font-size: var(--step-meta);
		line-height: 1.55;
	}

	.langs__item + .langs__item::before {
		content: '·';
		color: var(--rule-strong);
		padding-inline: 0.375rem;
	}

	.langs__name {
		font-weight: 600;
		color: var(--ink-2);
	}

	.langs__level {
		color: var(--ink-3);
	}

	.masthead__meta {
		margin-top: 0.25rem;
	}

	.masthead__meta :global(.contact) {
		margin-top: 0.625rem;
	}

	.masthead__rule {
		height: 2px;
		margin-top: clamp(1.75rem, 3vw, 2.25rem);
		background: var(--accent);
		transform-origin: left center;
	}

	/* One authored moment, and only on the first page of a session: the rule draws
	   and the portrait resolves. Switching locale afterwards does not replay it. */
	:global(html.intro) .masthead__rule {
		animation: rule-in 820ms var(--ease-out) both;
	}

	:global(html.intro) .masthead__photo {
		animation: photo-in 900ms var(--ease-out) both;
	}

	@keyframes rule-in {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	@keyframes photo-in {
		from {
			opacity: 0;
			filter: var(--photo-filter) blur(14px);
		}
	}

	@media (min-width: 48rem) {
		.masthead__main {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 1.5rem clamp(2rem, 4vw, 3.5rem);
			align-items: start;
		}

		.masthead__identity {
			grid-column: 1;
			grid-row: 1;
		}

		.masthead__meta {
			grid-column: 1;
			grid-row: 2;
			margin-top: 0;
		}

		.masthead__figure {
			grid-column: 2;
			grid-row: 1 / span 2;
			margin-top: 0.375rem;
		}

		.masthead__photo {
			width: 168px;
			height: 206px;
		}
	}

	@media (min-width: 60rem) {
		.masthead__photo {
			width: 196px;
			height: 240px;
		}
	}

	@media print {
		.masthead__figure {
			background: #fff;
		}

		.masthead__photo {
			filter: grayscale(1) contrast(1.04);
			mix-blend-mode: normal;
			-webkit-mask-image: none;
			mask-image: none;
			animation: none;
		}

		.masthead__rule {
			animation: none;
			background: #000;
		}
	}
</style>
