---
import { getResume, type Locale } from '../../data';
import ContactList from './ContactList.astro';
import DownloadPdf from './DownloadPdf.astro';
import JobEntry from './JobEntry.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import Masthead from './Masthead.astro';
import Section from './Section.astro';
import StackList from './StackList.astro';
import { localeTag } from './locale';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const resume = getResume(locale);
const ui = resume.ui;

// Midday UTC keeps the formatted date on the intended day in every timezone.
const updatedLong = new Intl.DateTimeFormat(localeTag[locale], { dateStyle: 'long' }).format(
	new Date(`${resume.updatedAt}T12:00:00Z`),
);
---

<div class="shell page">
	<Masthead resume={resume} />

	<main>
		<Section id="profile" title={ui.summary}>
			<p class="lede">{resume.summary}</p>
		</Section>

		<Section id="experience" title={ui.experience}>
			<div class="jobs">
				{resume.experience.map((job) => <JobEntry job={job} presentLabel={ui.present} />)}
			</div>
		</Section>

		{
			resume.projects.length > 0 && (
				<Section id="projects" title={ui.projects}>
					<ul class="entries">
						{resume.projects.map((project) => (
							<li class="entry">
								<h3 class="entry__title">
									{project.url ? <a href={project.url}>{project.name}</a> : project.name}
								</h3>
								<p class="entry__note">{project.description}</p>
								<StackList items={project.stack} />
							</li>
						))}
					</ul>
				</Section>
			)
		}

		<Section id="skills" title={ui.skills}>
			<div class="skills">
				{
					resume.skills.map((group) => (
						<div class="skillgroup">
							<h3 class="skillgroup__label">{group.label}</h3>
							<StackList items={group.items} />
						</div>
					))
				}
			</div>
		</Section>

		<Section id="education" title={ui.education}>
			<ul class="entries">
				{
					resume.education.map((item) => (
						<li class="entry">
							<h3 class="entry__title">{item.title}</h3>
							<p class="entry__sub">{item.institution}</p>
							{item.note && <p class="entry__note">{item.note}</p>}
						</li>
					))
				}
			</ul>
		</Section>

		<Section id="languages" title={ui.languages}>
			<ul class="entries">
				{
					resume.languages.map((language) => (
						<li class="entry">
							<h3 class="entry__title">
								{language.name}
								<span class="entry__level">{language.level}</span>
							</h3>
							{language.note && <p class="entry__note">{language.note}</p>}
						</li>
					))
				}
			</ul>
		</Section>
	</main>

	<footer class="footer">
		<div class="footer__contact">
			<h2 class="footer__title">{ui.contact}</h2>
			<ContactList contact={resume.contact} label={ui.contact} detail />
		</div>

		<div class="footer__side">
			<div class="footer__actions no-print">
				<DownloadPdf locale={locale} label={ui.downloadPdf} variant="quiet" />
				<LanguageSwitch locale={locale} label={ui.languageSwitch} />
			</div>
			<p class="footer__updated">{ui.updated} <time datetime={resume.updatedAt}>{updatedLong}</time></p>
		</div>
	</footer>
</div>

<style>
	.page {
		padding-bottom: clamp(2rem, 5vw, 4rem);
	}

	.jobs {
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 3.5vw, 2.75rem);
	}

	.entries {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.entry {
		display: flex;
		flex-direction: column;
		gap: 0.3125rem;
		break-inside: avoid;
	}

	.entry__title {
		font-family: var(--font-serif);
		font-size: var(--step-role);
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.012em;
		color: var(--ink);
		text-wrap: balance;
	}

	.entry__level {
		margin-left: 0.5rem;
		font-family: var(--font-sans);
		font-size: var(--step-meta);
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--ink-3);
	}

	.entry__sub {
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--ink-2);
		max-width: var(--measure);
	}

	.entry__note {
		font-size: var(--step-meta);
		line-height: 1.55;
		color: var(--ink-3);
		max-width: var(--measure);
		text-wrap: pretty;
	}

	.skills {
		display: grid;
		gap: 1.25rem 2.5rem;
	}

	.skillgroup {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		break-inside: avoid;
	}

	.skillgroup__label {
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-3);
	}

	.footer {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding-top: clamp(2.25rem, 4vw, 3.25rem);
		border-top: 1px solid var(--rule);
	}

	.footer__title {
		margin-bottom: 0.75rem;
		font-family: var(--font-sans);
		font-size: var(--step-label);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-3);
	}

	.footer__side {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: flex-start;
	}

	.footer__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.footer__updated {
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		letter-spacing: 0.01em;
		color: var(--ink-3);
		font-variant-numeric: tabular-nums;
	}

	@media (min-width: 48rem) {
		.skills {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 60rem) {
		.footer {
			flex-direction: row;
			justify-content: space-between;
			gap: 3rem;
		}

		.footer__side {
			align-items: flex-end;
			text-align: right;
		}
	}
</style>
