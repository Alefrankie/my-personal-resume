---
// Global stylesheet for the print/PDF pages. Single column, ATS friendly:
// real text, standard headings, no tables or multi-column layout for content.
//
// Palette and type pairing mirror the web page (warm paper, brick accent,
// serif/sans split) so the PDF reads as the same document, not a different one.
//
// System font stack on purpose. The web page's fontsource families were tried here and
// reverted: Chromium turns those variable woff2 faces into Type3 glyph procedures, which
// carry no embedded font program and lose ToUnicode entries for some glyphs (the "@" of
// the email address among them), so the extracted text degrades. System faces are embedded
// as CIDFontType2 subsets with intact ToUnicode, which is what ATS parsers need.
---

<style is:global>
	@page {
		size: A4;
		margin: 14mm 16mm;
	}

	:root {
		--ink: #191814;
		--ink-2: #45423a;
		--ink-3: #6b675c;
		--rule: #e2dccf;
		--rule-strong: #c8c0ae;
		--accent: #8a3324;
		--accent-wash: #f3e5e0;
		--serif: Georgia, 'Sitka Text', Cambria, Charter, 'Times New Roman', serif;
		--sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		font-size: 10pt;
	}

	body {
		margin: 0;
		/* White, not the web page's warm paper tint: a tinted body background prints as a
		   tinted box inside the page margins, leaving a visibly empty tinted strip under a
		   partly-filled last page. Ink and the brick accent carry the brand instead. */
		background: #ffffff;
		color: var(--ink);
		font-family: var(--sans);
		font-size: 1rem;
		line-height: 1.4;
		orphans: 3;
		widows: 3;
		-webkit-print-color-adjust: exact;
		print-color-adjust: exact;
		/* Ligatures off: Chromium emits a ligature as one glyph with no ToUnicode
		   entry, so "especificações" extracts as "especi?ações" and "@" disappears. */
		font-variant-ligatures: none;
		font-feature-settings: 'liga' 0, 'clig' 0, 'dlig' 0;
	}

	/* On screen the page is previewed with the same margins the PDF uses. */
	@media screen {
		body {
			max-width: 210mm;
			margin: 0 auto;
			padding: 14mm 16mm;
		}
	}

	p,
	ul,
	ol,
	h1,
	h2,
	h3 {
		margin: 0;
	}

	ul {
		padding: 0;
		list-style: none;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* Header ------------------------------------------------------------- */

	.masthead {
		break-inside: avoid;
	}

	.masthead h1 {
		font-family: var(--serif);
		font-size: 2.3rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.05;
		color: var(--ink);
	}

	.headline {
		font-family: var(--sans);
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.005em;
		color: var(--ink);
		margin-top: 4pt;
	}

	.tagline {
		font-family: var(--sans);
		font-size: 0.88rem;
		color: var(--ink-3);
		margin-top: 2.5pt;
	}

	.facts {
		font-size: 0.82rem;
		color: var(--ink-2);
		margin-top: 7pt;
		line-height: 1.45;
	}

	.facts-contact {
		margin-top: 2.5pt;
	}

	/* Small accent dot ahead of the availability line, echoing the web masthead. */
	.facts .dot {
		display: inline-block;
		width: 5pt;
		height: 5pt;
		margin-right: 3.5pt;
		margin-bottom: 0.5pt;
		border-radius: 50%;
		background: var(--accent);
		vertical-align: middle;
	}

	.facts .place {
		font-weight: 600;
		color: var(--ink);
	}

	.facts a {
		color: var(--ink);
		border-bottom: 0.5pt solid var(--rule-strong);
		/* Keep a phone number or a URL on one line. */
		white-space: nowrap;
	}

	.facts .sep {
		padding: 0 4pt;
		color: var(--rule-strong);
	}

	.masthead-rule {
		height: 1.4pt;
		margin-top: 9pt;
		background: var(--accent);
	}

	/* Sections ----------------------------------------------------------- */

	section {
		margin-top: 13pt;
		padding-top: 10pt;
		border-top: 0.75pt solid var(--rule);
	}

	/* Real in-flow element, not a positioned ::before: a generated-content pseudo-element
	   anchored with position:absolute has no positioned ancestor here, so it resolves
	   against the page's initial containing block. Chromium's tagged-PDF export then
	   places it outside the normal reading order, which pushed every section heading to
	   the end of the page in text-extraction order. A real sibling node in normal flow
	   can't do that: it's extracted exactly where it's painted. */
	section > h2 {
		display: flex;
		align-items: center;
		gap: 6pt;
		font-family: var(--sans);
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--ink-3);
		padding-top: 6pt;
		margin-bottom: 7pt;
		break-after: avoid;
		page-break-after: avoid;
	}

	.section-tick {
		flex: none;
		width: 11pt;
		height: 1.4pt;
		background: var(--accent);
	}

	/* No justification and no hyphenation: a hyphenated word break ends up in the
	   extracted PDF text ("tra-bajo"), which breaks ATS keyword matching. */
	.summary {
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.01rem;
		line-height: 1.52;
		color: var(--ink-2);
		text-align: left;
		hyphens: none;
	}

	/* Experience and projects -------------------------------------------- */

	.entry {
		break-inside: avoid;
		page-break-inside: avoid;
		margin-bottom: 9pt;
	}

	.entry:last-child {
		margin-bottom: 0;
	}

	.entry-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 8pt;
	}

	.entry-head h3 {
		font-family: var(--serif);
		font-size: 1.02rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.25;
		color: var(--ink);
	}

	.entry-head .company {
		font-family: var(--sans);
		font-weight: 500;
		font-size: 0.92rem;
		color: var(--ink-2);
	}

	.entry-meta {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--ink-2);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.01em;
	}

	.entry-summary {
		font-family: var(--serif);
		font-style: italic;
		font-size: 0.92rem;
		color: var(--ink-2);
		margin-top: 2pt;
		line-height: 1.4;
	}

	.bullets {
		margin-top: 4pt;
	}

	/* Same real-element rule as the section tick: no ::before, no position:absolute.
	   The tick is a real first child, laid out in flow by flex, so it can't be pulled out
	   of reading order by the tagged-PDF export. */
	.bullets li {
		display: flex;
		align-items: flex-start;
		gap: 6pt;
		margin-bottom: 2pt;
		color: var(--ink-2);
		line-height: 1.42;
	}

	.bullets .tick {
		flex: none;
		width: 6pt;
		height: 0.9pt;
		margin-top: 0.62em;
		background: var(--rule-strong);
	}

	.stack {
		font-size: 0.82rem;
		color: var(--ink-3);
		margin-top: 4pt;
	}

	.entry-place {
		font-weight: 400;
		color: var(--ink-3);
	}

	/* Compact list sections ---------------------------------------------- */

	/* Skills, Education and Languages are short: keep each whole on one page
	   instead of letting a list split across the page boundary. */
	section:has(> ul.lines) {
		break-inside: avoid;
		page-break-inside: avoid;
	}

	.lines li {
		break-inside: avoid;
		page-break-inside: avoid;
		margin-bottom: 3pt;
		color: var(--ink-2);
	}

	.lines li:last-child {
		margin-bottom: 0;
	}

	.lines .label {
		font-weight: 700;
		color: var(--ink);
	}

	.lines .note {
		color: var(--ink-3);
	}

	/* Footer -------------------------------------------------------------- */

	.updated {
		margin-top: 13pt;
		padding-top: 6pt;
		border-top: 0.5pt solid var(--rule);
		font-size: 0.76rem;
		color: var(--ink-3);
		break-inside: avoid;
	}
</style>
