---
// Global stylesheet for the print/PDF pages. Single column, ATS friendly:
// real text, standard headings, no tables or multi-column layout for content.
//
// System font stack on purpose. The web page's fontsource families were tried here and
// reverted: Chromium turns those variable woff2 faces into Type3 glyph procedures, which
// carry no embedded font program and lose ToUnicode entries for some glyphs (the "@" of
// the email address among them), so the extracted text degrades. System faces are embedded
// as CIDFontType2 subsets with intact ToUnicode, which is what ATS parsers need.
---

<style is:global>
	@page {
		size: A4;
		margin: 14mm 16mm;
	}

	:root {
		--ink: #16181d;
		--muted: #4c525b;
		--accent: #1f3d5c;
		--rule: #c6cad1;
		--serif: Charter, 'Bitstream Charter', 'Sitka Text', Cambria, Georgia, 'Times New Roman', serif;
		--sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		font-size: 10pt;
	}

	body {
		margin: 0;
		background: #fff;
		color: var(--ink);
		font-family: var(--sans);
		font-size: 1rem;
		line-height: 1.38;
		orphans: 3;
		widows: 3;
		-webkit-print-color-adjust: exact;
		print-color-adjust: exact;
		/* Ligatures off: Chromium emits a ligature as one glyph with no ToUnicode
		   entry, so "especificações" extracts as "especi?ações" and "@" disappears. */
		font-variant-ligatures: none;
		font-feature-settings: 'liga' 0, 'clig' 0, 'dlig' 0;
	}

	/* On screen the page is previewed with the same margins the PDF uses. */
	@media screen {
		body {
			max-width: 210mm;
			margin: 0 auto;
			padding: 14mm 16mm;
		}
	}

	p,
	ul,
	ol,
	h1,
	h2,
	h3 {
		margin: 0;
	}

	ul {
		padding: 0;
		list-style: none;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* Header ------------------------------------------------------------- */

	.masthead {
		break-inside: avoid;
		border-bottom: 1pt solid var(--rule);
		padding-bottom: 7pt;
	}

	.masthead h1 {
		font-family: var(--serif);
		font-size: 2.1rem;
		font-weight: 600;
		letter-spacing: -0.012em;
		line-height: 1.1;
	}

	.headline {
		font-family: var(--serif);
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--accent);
		margin-top: 2.5pt;
	}

	.tagline {
		font-size: 0.9rem;
		color: var(--muted);
		margin-top: 2pt;
	}

	.facts {
		font-size: 0.82rem;
		color: var(--muted);
		margin-top: 5pt;
		line-height: 1.45;
	}

	.facts-contact {
		margin-top: 2pt;
	}

	.facts a {
		color: var(--ink);
		border-bottom: 0.5pt solid var(--rule);
		/* Keep a phone number or a URL on one line. */
		white-space: nowrap;
	}

	.facts .sep {
		padding: 0 4pt;
		color: var(--rule);
	}

	/* Sections ----------------------------------------------------------- */

	section {
		margin-top: 12pt;
	}

	section > h2 {
		font-family: var(--serif);
		font-size: 0.92rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--accent);
		border-bottom: 0.75pt solid var(--rule);
		padding-bottom: 2.5pt;
		margin-bottom: 6pt;
		break-after: avoid;
		page-break-after: avoid;
	}

	/* No justification and no hyphenation: a hyphenated word break ends up in the
	   extracted PDF text ("tra-bajo"), which breaks ATS keyword matching. */
	.summary {
		text-align: left;
		hyphens: none;
	}

	/* Experience and projects -------------------------------------------- */

	.entry {
		break-inside: avoid;
		page-break-inside: avoid;
		margin-bottom: 8pt;
	}

	.entry:last-child {
		margin-bottom: 0;
	}

	.entry-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 8pt;
	}

	.entry-head h3 {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.entry-head .company {
		font-weight: 500;
		color: var(--accent);
	}

	.entry-meta {
		font-size: 0.82rem;
		color: var(--muted);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.entry-summary {
		font-size: 0.9rem;
		color: var(--muted);
		margin-top: 1.5pt;
	}

	.bullets {
		margin-top: 3pt;
		padding-left: 11pt;
		list-style: disc;
	}

	.bullets li {
		margin-bottom: 1.5pt;
		padding-left: 1pt;
	}

	.stack {
		font-size: 0.84rem;
		color: var(--muted);
		margin-top: 3pt;
	}

	.entry-place {
		font-weight: 400;
		color: var(--muted);
	}

	/* Compact list sections ---------------------------------------------- */

	/* Skills, Education and Languages are short: keep each whole on one page
	   instead of letting a list split across the page boundary. */
	section:has(> ul.lines) {
		break-inside: avoid;
		page-break-inside: avoid;
	}

	.lines li {
		break-inside: avoid;
		page-break-inside: avoid;
		margin-bottom: 2.5pt;
	}

	.lines li:last-child {
		margin-bottom: 0;
	}

	.lines .label {
		font-weight: 600;
	}

	.lines .note {
		color: var(--muted);
	}

	/* Footer -------------------------------------------------------------- */

	.updated {
		margin-top: 12pt;
		padding-top: 5pt;
		border-top: 0.5pt solid var(--rule);
		font-size: 0.78rem;
		color: var(--muted);
		break-inside: avoid;
	}
</style>
