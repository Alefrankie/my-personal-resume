---
// Print view, one page per locale: /print/en/, /print/es/, /print/pt/.
// scripts/generate-pdf.mjs renders these with Chromium to produce the downloadable PDFs.
// Plain dynamic route on purpose: it must build with or without Astro i18n routing configured.
import { getResume, locales } from '../../data';
import type { Locale } from '../../data/types';
import PrintStyles from '../../components/pdf/PrintStyles.astro';
import ResumeDocument from '../../components/pdf/ResumeDocument.astro';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const resume = getResume(lang);

/** BCP 47 tag for the document. The Portuguese content is European Portuguese. */
const htmlLang: Record<Locale, string> = { en: 'en', es: 'es', pt: 'pt-PT' };
---

<!doctype html>
<html lang={htmlLang[resume.locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{resume.meta.title}</title>
		<meta name="author" content={resume.name} />
		<meta name="description" content={resume.meta.description} />
		<PrintStyles />
	</head>
	<body>
		<ResumeDocument resume={resume} />
	</body>
</html>
