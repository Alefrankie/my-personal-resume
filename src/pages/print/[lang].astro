---
// Print view for the non-default locales: /print/es/, /print/pt/.
// English lives at src/pages/print/index.astro (unprefixed), not here: Astro's i18n
// middleware (prefixDefaultLocale: false) strip-redirects any request whose last path
// segment equals the default locale code, so a literal /print/en/ 404s in dev (it only
// "worked" at build time because the static dev server never runs that redirect check).
// Keeping the default locale unprefixed mirrors how the site's own routes already work.
import { defaultLocale, locales } from '../../data';
import type { Locale } from '../../data/types';
import PrintPage from '../../components/pdf/PrintPage.astro';

export function getStaticPaths() {
	return locales.filter((lang) => lang !== defaultLocale).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<PrintPage locale={lang} />
